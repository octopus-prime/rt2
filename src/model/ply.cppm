module;

#include <filesystem>

export module model:ply;

import :mesh;

export namespace rt2::model {

// Reads ASCII or either-endian binary PLY. Requires scalar vertex x/y/z and
// triangular face vertex_indices. Other properties are ignored; normals are
// generated by mesh_t. Coordinates and winding are preserved (no recentering).
// Throws with the filename on I/O, format or invalid geometry errors.
mesh_t read_ply(const std::filesystem::path& file);

}
